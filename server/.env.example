# Copy this file to server/.env and fill in the values. server/.env is not on GitHub.

# Key that signs the logins, any long random text, for example the output of
# python -c "import secrets; print(secrets.token_hex(32))"
# Without it the server makes a random one at every start and the logins end at every restart.
SECRET_KEY=

# Account that sends the booking confirmation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
